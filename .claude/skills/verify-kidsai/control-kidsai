#!/usr/bin/env python3
"""control-kidsai — 在專用 iOS 模擬器上啟動、檢查、操作 KidsAI，並錄下可發布的證據。

只用 Python 3 標準函式庫。所有輸出都是 JSON（加 --human 印成人看的格式）。
說明：.claude/skills/verify-kidsai/SKILL.md；測試：tests/test_control_kidsai.py。
"""

import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
from kidsai_core import *  # noqa: E402,F401,F403
from kidsai_evidence import *  # noqa: E402,F401,F403
from kidsai_flows import *  # noqa: E402,F401,F403


# ---------------------------------------------------------------- CLI

EPILOG = """結束碼：0 成功｜2 用法錯｜3 環境不對｜4 拒絕危險操作｜5 外部命令失敗｜6 證據不合格｜7 舊 build

完整流程（證明「開 App → 看到地圖」）：
  C=.claude/skills/verify-kidsai/control-kidsai
  $C sim ensure && $C sim boot && $C sim statusbar
  $C build && $C install && $C doctor
  $C run new --feature map --entry app-launch          # 印出 run id
  $C record start --run <run> --name map-launch
  $C launch                                             # 觸發：打開 App
  $C screenshot --run <run> --name map-islands          # 終態：地圖
  $C record stop --run <run> --name map-launch
  $C cleanup                                            # 證據留在 .verify/<run>/
  $C evidence frames --run <run>                        # 逐張看過畫面內容
  $C evidence review --run <run> --ok
  $C evidence publish --pr <N> --run <run> --dry-run
  $C evidence publish --pr <N> --run <run>

真實點擊（XCUITest，要先 build --for-testing）：
  $C build --for-testing && $C install && $C doctor
  $C drive --flow sandbox-pick-and-react                 # 只跑、不錄；連跑 3 次抓不穩定
  $C run new --feature sandbox --entry multi-card
  $C record --flow sandbox-pick-and-react --run <run>    # 前置畫面 → 點擊 → 最終狀態，≤20 秒
  $C snapshot --run <run> --name sandbox-tree --unit 1 --beat 5
"""


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="control-kidsai", description="在專用 iOS 模擬器上操作 KidsAI、錄證據、發布到證據 repo。",
                                epilog=EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--sim", default=os.environ.get("KIDSAI_SIM", "KidsAI-Verify"), help="專用模擬器：KidsAI-Verify（預設）或 KidsAI-Maintain")
    p.add_argument("--human", action="store_true", help="印成人看的格式（預設 JSON）")
    sub = p.add_subparsers(dest="command", required=True, metavar="{doctor,sim,build,install,launch,terminate,run,screenshot,record,drive,snapshot,cleanup,evidence}")
    sub.add_parser("doctor", help="唯讀健康檢查：模擬器、status bar、只裝 KidsAI、Debug、舊 build、螢幕尺寸")
    sim = sub.add_parser("sim", help="專用模擬器：ensure｜boot｜shutdown｜erase｜statusbar")
    sim.add_argument("action", choices=["ensure", "boot", "shutdown", "erase", "statusbar"])
    sim.add_argument("--yes", action="store_true", help="erase 一定要加")
    sim.add_argument("--dry-run", action="store_true")
    build = sub.add_parser("build", help="xcodegen＋xcodebuild（Debug、模擬器），寫 build stamp")
    build.add_argument("--dry-run", action="store_true")
    build.add_argument("--for-testing", action="store_true", help="build-for-testing：連 UI 測試 runner 一起 build（drive、record --flow 需要）")
    sub.add_parser("install", help="安裝最新 build 到專用模擬器")
    launch = sub.add_parser("launch", help="啟動 App（會先關掉舊的）；啟動參數只能準備前置狀態，不能當證明")
    launch.add_argument("--unit", type=int, help="-openUnit：直接打開第幾個單元（0 起算）")
    launch.add_argument("--beat", type=int, help="-beat：從第幾關開始")
    launch.add_argument("--events", help='-events：開場後套用一串操作，例如 "place:cup_star:blank_where;check"')
    launch.add_argument("--unlock-all", action="store_true", help="-unlockAll：所有單元都可進")
    sub.add_parser("terminate", help="關掉 App")
    run = sub.add_parser("run", help="run new：建立 .verify/<run-id>/ 與 manifest")
    run.add_argument("action", choices=["new"])
    run.add_argument("--feature", required=True)
    run.add_argument("--entry", required=True)
    shot = sub.add_parser("screenshot", help="截圖並記入 manifest")
    shot.add_argument("--run", required=True)
    shot.add_argument("--name", required=True)
    rec = sub.add_parser("record", help="錄影 start｜stop（≤20 秒，h264，另產 GIF）；或 --flow 錄一支真實點擊流程")
    rec.add_argument("action", nargs="?", choices=["start", "stop"])
    rec.add_argument("--run", required=True)
    rec.add_argument("--name")
    rec.add_argument("--flow", choices=sorted(FLOWS), help="錄「前置畫面 → 真實點擊 → 最終狀態」（握手同步，≤20 秒）")
    drive = sub.add_parser("drive", help="只跑一支真實點擊流程（不錄影），回報通過或失敗")
    drive.add_argument("--flow", required=True, choices=sorted(FLOWS))
    snap = sub.add_parser("snapshot", help="把目前畫面的無障礙元素樹存成 JSON（kind a11y）")
    snap.add_argument("--run", required=True)
    snap.add_argument("--name", required=True)
    snap.add_argument("--unit", type=int, help="前置狀態：-openUnit")
    snap.add_argument("--beat", type=int, help="前置狀態：-beat")
    sub.add_parser("cleanup", help="只停本次啟動的錄影、App、模擬器；不刪證據").add_argument("--dry-run", action="store_true")
    ev = sub.add_parser("evidence", help="frames｜review｜md｜publish")
    ev.add_argument("action", choices=["frames", "review", "md", "publish"])
    ev.add_argument("--run")
    ev.add_argument("--pr", type=int)
    ev.add_argument("--ok", action="store_true", help="review：確認逐張看過、畫面只有 KidsAI 或專用模擬器主畫面")
    ev.add_argument("--dry-run", action="store_true", help="publish：完全不寫入、不連網")
    return p


HANDLERS = {"doctor": cmd_doctor, "sim": cmd_sim, "build": cmd_build, "install": cmd_install, "launch": cmd_launch,
            "terminate": cmd_terminate, "run": cmd_run, "screenshot": cmd_screenshot, "record": cmd_record,
            "cleanup": cmd_cleanup, "evidence": cmd_evidence, "drive": cmd_drive, "snapshot": cmd_snapshot}


def emit(result: dict, human: bool) -> None:
    if human:
        for key, value in result.items():
            print(f"{key}: {value if isinstance(value, str) else json.dumps(value, ensure_ascii=False)}")
    else:
        print(json.dumps(result, ensure_ascii=False, indent=2))


def main(argv=None, ctx: Optional[Context] = None) -> int:
    try:
        args = parser().parse_args(argv)
    except SystemExit as exit_:
        return int(exit_.code or 0)
    if ctx is None:
        repo = Path(os.environ.get("KIDSAI_REPO") or Path(__file__).resolve().parents[3])
        ctx = Context(repo=repo, home=Path.home(), runner=Runner())
    ctx.sim = args.sim
    try:
        if ctx.sim not in SIMS:
            raise Fail(EXIT_REFUSED, f"只能操作專用模擬器 {' 或 '.join(SIMS)}，不能用 {ctx.sim}", "--sim KidsAI-Verify")
        if args.command == "evidence" and args.action in ("md", "publish") and args.pr is None:
            raise Fail(EXIT_USAGE, "需要 --pr <編號>", "先開 draft PR 取得編號")
        result = HANDLERS[args.command](ctx, args)
        code = result.pop("exit", EXIT_OK) if args.command == "doctor" else EXIT_OK
        emit(result, args.human)
        return code
    except Fail as fail:
        emit({"ok": False, "error": fail.message, "fix": fail.fix, "exit": fail.code}, args.human)
        return fail.code
    except (OSError, ValueError, KeyError, TypeError) as error:
        emit({"ok": False, "error": f"非預期的錯誤：{type(error).__name__}：{error}", "fix": "回報這個輸出", "exit": EXIT_EXTERNAL},
             args.human)
        return EXIT_EXTERNAL


if __name__ == "__main__":
    sys.exit(main())
